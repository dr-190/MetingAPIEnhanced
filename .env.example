
# MetingAPIEnhanced 配置示例
# 复制此文件为 .env 并按需修改


# ──────────────────────────────────────────
#  服务设置
# ──────────────────────────────────────────

PORT = 3456


# ──────────────────────────────────────────
#  CORS 资源共享设置
#  如果你需要配置, 请取消下面的注释并设置具体的域名
# ──────────────────────────────────────────

# CORS_ALLOW_ORIGIN = "*"


# ──────────────────────────────────────────
#  代理设置
# ──────────────────────────────────────────

## 启用反向代理
ENABLE_PROXY = false

## 代理地址
PROXY_URL = "https://your-proxy-url.com/?proxy="


# ──────────────────────────────────────────
#  随机 IP 设置
#  启用后所有请求默认使用随机中国IP
#  除非请求参数 randomCNIP 显式关闭
# ──────────────────────────────────────────

ENABLE_RANDOM_CN_IP = false


# ──────────────────────────────────────────
#  UnblockNeteaseMusic 设置
# ──────────────────────────────────────────

## 启用全局解灰（无论是否传参都会解灰，不推荐开启）
ENABLE_GENERAL_UNBLOCK = false

## 启用无损音质（FLAC）
ENABLE_FLAC = true

## 启用无损音质时，是否选择音质最高的
SELECT_MAX_BR = false

## 严格按照配置音源顺序进行匹配
FOLLOW_SOURCE_ORDER = true


# ──────────────────────────────────────────
#  Cookie 设置
#  推荐在 Vercel 等平台通过环境变量配置
#  格式：MUSIC_U=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ──────────────────────────────────────────

# NETEASE_COOKIE = ""


# ──────────────────────────────────────────
#  Meting 设置
# ──────────────────────────────────────────

## 基础 URL（用于构建 meting 链接，留空则自动推断）
# BASE_URL = "https://your-domain.com"
