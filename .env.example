# MetingAPIEnhanced 配置示例
# 复制此文件为 .env 并修改配置

# 服务端口
PORT=3456

# CORS 配置（允许跨域请求的域名）
CORS_ALLOW_ORIGIN=*

# 启用随机中国 IP
ENABLE_RANDOM_CN_IP=true

# 启用全局解灰（推荐开启）
ENABLE_GENERAL_UNBLOCK=true

# 启用无损音质（FLAC）
ENABLE_FLAC=true

# 选择最高码率音质
SELECT_MAX_BR=false

# 遵循音源顺序
FOLLOW_SOURCE_ORDER=true

# 代理配置（可选）
# ENABLE_PROXY=false
# PROXY_URL=https://your-proxy-url.com/?proxy=

# 基础 URL（可选，用于构建 meting 链接）
# BASE_URL=https://your-domain.com
